# ============================================================
# Firebase Client SDK (used in the browser)
# Get these from: Firebase Console > Project Settings > Your Apps
# ============================================================
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ============================================================
# Dev-only superadmin bypass (only active when NODE_ENV=development)
# Use these credentials on the login page to skip Firebase auth entirely
# ============================================================
NEXT_PUBLIC_DEV_SUPERADMIN_USER=superadmin
NEXT_PUBLIC_DEV_SUPERADMIN_PASS=admin

# ============================================================
# Firebase Admin SDK (server-side only — never prefix with NEXT_PUBLIC_)
# Get these from: Firebase Console > Project Settings > Service Accounts
# Generate a new private key and copy the values here
# ============================================================
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_ADMIN_CLIENT_ID=your_client_id

# ============================================================
# MongoDB Atlas Connection Strings
# Get these from: MongoDB Atlas > Database > Connect > Drivers
# Create 3 database users with different permission levels
# ============================================================
MONGODB_ADMIN_URI="mongodb+srv://adminUser:password@cluster.mongodb.net/?retryWrites=true&w=majority&appName=YourApp"
MONGODB_READ_ONLY_URI="mongodb+srv://readOnlyUser:password@cluster.mongodb.net/?retryWrites=true&w=majority&appName=YourApp"
MONGODB_READ_AND_WRITE_URI="mongodb+srv://readWriteUser:password@cluster.mongodb.net/?retryWrites=true&w=majority&appName=YourApp"
